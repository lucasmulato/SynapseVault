# SynapseVault API (MCP Gateway + HTTP REST)

# PostgreSQL connection string.
# In Docker this is injected by docker-compose; override locally if needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synapsevault

# Port for the HTTP REST surface (also serves the MCP stdio transport).
# Default: 3000
HTTP_PORT=3000

# OPTIONAL: reasoning agent over any OpenAI-compatible endpoint.
# Get a free key at https://groq.com (no credit card needed).
# Leave LLM_API_KEY empty to disable the /api/chat feature entirely.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
